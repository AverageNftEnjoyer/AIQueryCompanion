# Required secrets
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
ANALYSIS_AGENT_ID=
HARDCODE_AGENT_ID=

# Endpoint/model configuration
OPENAI_BASE_URL=https://api.openai.com/v1
ANALYSIS_AGENT_MODEL=gpt-4.1-nano

# Request and retry tuning
ANALYZE_REQUEST_TIMEOUT_MS=55000
SUMMARY_REQUEST_TIMEOUT_MS=65000
FETCH_TIMEOUT_MS=55000
LLM_RETRIES=1
MAX_ITEMS_TO_EXPLAIN=80
ANALYSIS_MODEL_CLIP_BYTES=12000
ANALYZE_PAGE_LIMIT=30
